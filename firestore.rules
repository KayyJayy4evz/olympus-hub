rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only Khayla's verified Custom Ink account can read or write anything.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "khayla.mcgowan@customink.com";
    }
  }
}
